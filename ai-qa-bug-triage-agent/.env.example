# App
APP_NAME=AI QA Bug Triage Automation Agent
APP_ENV=development
DATABASE_URL=sqlite:///./bug_triage.db
HUMAN_REVIEW_SEVERITIES=critical,high
DUPLICATE_THRESHOLD=82

# OpenAI (optional - app works in deterministic demo mode without this)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
USE_OPENAI=false

# Jira Cloud (optional)
JIRA_ENABLED=false
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=QA
JIRA_ISSUE_TYPE=Bug
